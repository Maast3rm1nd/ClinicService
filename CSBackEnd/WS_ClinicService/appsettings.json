{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=clinic.db"
  },
  "Database": {
    "Provider": "sqlite",
    "AutoMigrate": true
  },
  "Jwt": {
    "Issuer": "https://api.clinic.local",
    "Audience": "https://api.clinic.local",
    "ExpiresMinutes": 15
  }
}