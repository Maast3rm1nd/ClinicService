<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
	<Version>0.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.*" />
    <PackageReference Include="dbup-core" Version="6.*" />
    <PackageReference Include="dbup-postgresql" Version="7.*" />
    <PackageReference Include="dbup-sqlite" Version="6.*" />
    <PackageReference Include="dbup-sqlserver" Version="7.*" />
  </ItemGroup>

</Project>
